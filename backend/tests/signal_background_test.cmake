# Exercise the existing CLI/self-tests with isolated fixtures, never the local B map.
foreach(required COMPARE_EXE OFF_CONFIG TEST_ROOT)
    if(NOT DEFINED ${required})
        message(FATAL_ERROR "Missing ${required}")
    endif()
endforeach()
string(TIMESTAMP stamp "%Y%m%d_%H%M%S")
string(RANDOM LENGTH 8 ALPHABET 0123456789abcdef nonce)
set(root "${TEST_ROOT}/${stamp}-${nonce}")
if(EXISTS "${root}")
    message(FATAL_ERROR "Refusing to overwrite ${root}")
endif()
file(MAKE_DIRECTORY "${root}")
file(READ "${OFF_CONFIG}" config)
file(WRITE "${root}/background.csv" "range_bin,u_bin,v_bin\n100000,100000,100000\n")
file(WRITE "${root}/on.cfg" "${config}\nbackground.map_path = ${root}/background.csv\n")
file(WRITE "${root}/missing.cfg" "${config}\nbackground.map_path = ${root}/does-not-exist.csv\n")

function(run_case label expected)
    execute_process(COMMAND "${COMPARE_EXE}" ${ARGN}
        RESULT_VARIABLE result OUTPUT_VARIABLE stdout ERROR_VARIABLE stderr TIMEOUT 25)
    file(WRITE "${root}/${label}.stdout.log" "${stdout}")
    file(WRITE "${root}/${label}.stderr.log" "${stderr}")
    if(expected STREQUAL "PASS")
        if(NOT "${result}" STREQUAL "0")
            message(FATAL_ERROR "${label}: ${result}\n${stdout}\n${stderr}")
        endif()
    elseif(NOT "${result}" MATCHES "^[12]$")
        message(FATAL_ERROR "${label}: expected a validation failure, got ${result}\n${stdout}\n${stderr}")
    endif()
    set(last_stderr "${stderr}" PARENT_SCOPE)
endfunction()

function(check_json path expected)
    file(READ "${path}" document)
    string(JSON actual GET "${document}" ${ARGN})
    if(NOT "${actual}" STREQUAL "${expected}")
        message(FATAL_ERROR "${path}: ${ARGN}: expected ${expected}, got ${actual}")
    endif()
endfunction()

# Same parser/chunking/order/EOF/deadline/freeze suite in both modes; no live TCP.
run_case(off-wire PASS --tcp-self-test "${OFF_CONFIG}" --output "${root}/off-wire")
run_case(on-wire PASS --tcp-self-test "${root}/on.cfg" --require-background --output "${root}/on-wire")
set(input "${root}/off-wire/self_test_input.csv")
set(baseline "${root}/off-wire/tcp_reference_frames.csv")
run_case(off-compare PASS "${OFF_CONFIG}" "${input}" "${baseline}" "${root}/off-compare")
run_case(on-compare PASS "${root}/on.cfg" "${input}" "${root}/on-compare" --require-background)

set(summary "${root}/on-compare/comparison_summary.json")
check_json("${summary}" ON passed)
check_json("${summary}" ON background_direct)
check_json("${summary}" ON background_adapter)
check_json("${summary}" ON background_required)
check_json("${summary}" generated_background_on baseline_source)
check_json("${summary}" OFF external_baseline_compared)
check_json("${summary}" 0 difference_count)
check_json("${summary}" 36 background_stats_direct input_points)
check_json("${summary}" 36 background_stats_adapter input_points)
check_json("${summary}" 0 background_stats_direct removed_points)
check_json("${summary}" 0 background_stats_adapter removal_rate_percent)
check_json("${summary}" 3 background_stats_adapter processed_frames)
check_json("${root}/off-compare/comparison_summary.json" OFF background_direct)
check_json("${root}/off-compare/comparison_summary.json" OFF background_adapter)
check_json("${root}/off-compare/comparison_summary.json" OFF background_required)
check_json("${root}/off-compare/comparison_summary.json" ON external_baseline_compared)

set(summary "${root}/on-wire/tcp_comparison_summary.json")
check_json("${summary}" ON passed)
check_json("${summary}" ON complete)
check_json("${summary}" ON background_enabled)
check_json("${summary}" ON background_direct)
check_json("${summary}" ON background_live)
check_json("${summary}" 2 excluded_before_sync)
check_json("${summary}" 3 verified_frames)
check_json("${summary}" 36 verified_points)
check_json("${summary}" 36 background_stats_direct input_points)
check_json("${summary}" 36 background_stats_live input_points)
check_json("${summary}" 3 background_stats_live processed_frames)
check_json("${summary}" 0 background_stats_live removed_points)
check_json("${summary}" 0 background_stats_live removal_rate_percent)
check_json("${root}/off-wire/tcp_comparison_summary.json" OFF background_enabled)
check_json("${root}/off-wire/tcp_comparison_summary.json" "" background_stats_live removal_rate_percent)

foreach(cfg "${OFF_CONFIG}" "${root}/missing.cfg")
    get_filename_component(label "${cfg}" NAME_WE)
    run_case("${label}-offline-rejected" FAIL "${cfg}" "${input}" "${root}/${label}-offline" --require-background)
    if(NOT last_stderr MATCHES "usesBackground\\(\\)=false")
        message(FATAL_ERROR "Missing actual OFF diagnostic: ${last_stderr}")
    endif()
    # These must stop at reference initialization, before any connect attempt.
    run_case("${label}-tcp-rejected" FAIL --tcp 127.0.0.1 1 --config "${cfg}"
        --input "${input}" --output "${root}/${label}-tcp" --require-background)
    set(summary "${root}/${label}-tcp/tcp_comparison_summary.json")
    check_json("${summary}" OFF passed)
    check_json("${summary}" OFF background_enabled)
    check_json("${summary}" OFF background_direct)
    check_json("${summary}" "" background_live)
    check_json("${summary}" background_requirement_not_met termination_reason)
    check_json("${summary}" 0 received_tcp_frames)
endforeach()
run_case(on-with-off-baseline FAIL "${root}/on.cfg" "${input}" "${baseline}"
    "${root}/forbidden-baseline" --require-background)
run_case(tcp-on-with-off-baseline FAIL --tcp 127.0.0.1 1 --config "${root}/on.cfg"
    --input "${input}" --baseline "${baseline}" --output "${root}/forbidden-tcp" --require-background)
run_case(default-off-on-map FAIL "${root}/on.cfg" "${input}" "${baseline}" "${root}/default-off")
if(NOT last_stderr MATCHES "usesBackground\\(\\)=true")
    message(FATAL_ERROR "Default OFF did not report actual ON: ${last_stderr}")
endif()
run_case(tcp-default-off-on-map FAIL --tcp 127.0.0.1 1 --config "${root}/on.cfg"
    --input "${input}" --baseline "${baseline}" --output "${root}/tcp-default-off")
check_json("${root}/tcp-default-off/tcp_comparison_summary.json" OFF passed)
check_json("${root}/tcp-default-off/tcp_comparison_summary.json" ON background_direct)
check_json("${root}/tcp-default-off/tcp_comparison_summary.json" OFF background_required)
check_json("${root}/tcp-default-off/tcp_comparison_summary.json" background_requirement_not_met termination_reason)
message(STATUS "Background ON/OFF CLI and JSON checks passed: ${root}")
